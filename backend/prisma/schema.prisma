generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  UPI
  RAZORPAY
  CARD
  COD
}

model User {
  id        Int        @id @default(autoincrement())
  email     String?    @unique
  password  String?
  name      String
  phone     String     @unique
  birthday  DateTime?
  role      Role       @default(CUSTOMER)
  orders    Order[]
  reviews   Review[]
  addresses Address[]
  wishlist  Wishlist[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Category {
  id        Int       @id @default(autoincrement())
  slug      String    @unique
  name      String
  tagline   String?
  image     String?
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id            Int         @id @default(autoincrement())
  slug          String      @unique
  name          String
  categoryId    Int?
  category      Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categorySlug  String
  categoryLabel String
  price         Decimal     @db.Decimal(10, 2)
  mrp           Decimal     @db.Decimal(10, 2)
  makingCharges Decimal     @default(0) @db.Decimal(10, 2)
  image         String      @db.Text
  weight        Float
  metal         String      @default("925 Sterling Silver")
  occasion      String
  collection    String
  badge         String?
  rating        Float       @default(5.0)
  reviewsCount  Int         @default(0)
  stock         Int         @default(10)
  popularity    Int         @default(50)
  description   String      @db.Text
  isFeatured    Boolean     @default(false)
  orderItems    OrderItem[]
  reviews       Review[]
  wishlistedBy  Wishlist[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Order {
  id              Int           @id @default(autoincrement())
  orderNumber     String        @unique
  userId          Int?
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName    String
  customerEmail   String
  customerPhone   String
  addressLine1    String
  addressLine2    String?
  city            String
  state           String
  pincode         String
  totalAmount     Decimal       @db.Decimal(10, 2)
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  paymentMethod   PaymentMethod @default(COD)
  paymentId       String?
  trackingNumber  String?
  items           OrderItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model OrderItem {
  id           Int      @id @default(autoincrement())
  orderId      Int
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    Int?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName  String
  productSlug  String
  productImage String   @db.Text
  price        Decimal  @db.Decimal(10, 2)
  quantity     Int
  total        Decimal  @db.Decimal(10, 2)
}



model Review {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName  String
  rating    Int
  comment   String   @db.Text
  verified  Boolean  @default(true)
  status    String   @default("APPROVED") // PENDING, APPROVED, REJECTED
  createdAt DateTime @default(now())
}

model Address {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  name      String
  phone     String
  address   String   @db.Text
  city      String
  pincode   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Banner {
  id          String   @id @default(cuid())
  image       String   @db.Text
  alt         String
  eyebrow     String
  titleTop    String
  titleBottom String
  copy        String
  cta         String
  category    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PromoTile {
  id          String   @id @default(cuid())
  eyebrow     String
  titleTop    String
  titleBottom String
  cta         String
  image       String   @db.Text
  dark        Boolean  @default(false)
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model SystemSetting {
  key   String @id
  value String
}

model Coupon {
  id            Int      @id @default(autoincrement())
  code          String   @unique
  discountType  String   // "PERCENT" or "FLAT"
  discountValue Float
  minOrderValue Float?
  maxDiscount   Float?
  active        Boolean  @default(true)
  usageLimit    Int?
  usageCount    Int      @default(0)
  expiresAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
